{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syy-uime.dev/schemas/config.schema.json",
  "title": "syy-uime Configuration",
  "type": "object",
  "required": ["project", "target", "routes", "viewports"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" }
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "storageState": { "type": "string" }
      }
    },
    "routes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "functional": { "type": "boolean" },
        "consistent": { "type": "boolean" },
        "accessible": { "type": "boolean" },
        "responsive": { "type": "boolean" }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "overall": { "type": "number" },
        "functional": { "type": "number" },
        "consistent": { "type": "number" },
        "accessible": { "type": "number" },
        "responsive": { "type": "number" }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "start", "steps"],
        "properties": {
          "name": { "type": "string" },
          "start": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": { "type": "string", "enum": ["fill", "click", "assert-visible", "assert-text", "press", "navigate", "select", "hover"] },
                "selector": { "type": "string" },
                "value": { "type": "string" },
                "key": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
