{
  "$metadata": {
    "description": "Demo design tokens exported from Figma (oklch)",
    "tokenSetOrder": ["primitives", "light"]
  },
  "primitives": {
    "color": {
      "primary": { "$type": "color", "$value": "oklch(0.55 0.22 263)" },
      "primary-text": { "$type": "color", "$value": "oklch(1 0 0)" },
      "surface": { "$type": "color", "$value": "oklch(1 0 0)" },
      "bg": { "$type": "color", "$value": "oklch(0.97 0.003 248)" },
      "text": { "$type": "color", "$value": "oklch(0.28 0.04 260)" },
      "border": { "$type": "color", "$value": "oklch(0.87 0.02 250)" },
      "btn-bg": { "$type": "color", "$value": "oklch(0.92 0.01 250)" },
      "success-bg": { "$type": "color", "$value": "oklch(0.95 0.05 150)" },
      "success-border": { "$type": "color", "$value": "oklch(0.9 0.15 155)" }
    },
    "radius": {
      "md": { "$type": "borderRadius", "$value": "4px" }
    },
    "spacing": {
      "xs": { "$type": "dimension", "$value": "8px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "24px" },
      "xl": { "$type": "dimension", "$value": "32px" }
    },
    "font-size": {
      "sm": { "$type": "fontSize", "$value": "14px" },
      "base": { "$type": "fontSize", "$value": "16px" },
      "lg": { "$type": "fontSize", "$value": "18px" },
      "xl": { "$type": "fontSize", "$value": "32px" }
    },
    "font-family": {
      "body": { "$type": "fontFamily", "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" }
    }
  },
  "light": {
    "link": { "$type": "color", "$value": "{primitives.color.primary}" }
  }
}
